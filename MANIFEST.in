include LICENSE
include README.md
include CHANGELOG.md
include pyproject.toml

# Cython sources + C/C++ headers for the package (so the sdist can be recompiled)
recursive-include cy_redis *.pyx *.pxd *.pyi *.hpp *.h py.typed

# Vendored hiredis — sources, headers, and Makefile only. libhiredis.a is
# deliberately NOT shipped: a static archive is platform-specific, and
# setup.py rebuilds it from these sources on every fresh sdist install.
recursive-include hiredis *.c *.h Makefile

# Lua scripts shipped as package data inside cy_redis/lua_scripts/
recursive-include cy_redis/lua_scripts *.lua *.md

# Examples and docs
recursive-include examples *.py *.md
recursive-include docs *.md *.rst

global-exclude *.pyc
global-exclude *.pyo
global-exclude *.so
global-exclude *.o
global-exclude *.a
global-exclude __pycache__
global-exclude .DS_Store
global-exclude .git*
prune .github
# Unsupported subsystems: developed in-repo, never shipped on PyPI.
prune experimental
prune build
prune dist
prune htmlcov
